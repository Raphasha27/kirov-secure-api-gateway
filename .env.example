# Kirov Secure API Gateway — env prefix KG_
# Copy this file to .env and fill in real values
KG_DATABASE_URL=postgresql://kirov:kirov@localhost:5432/kirov_gateway
KG_JWT_SECRET=change-me-to-a-real-secret
KG_JWT_ALGORITHM=HS256
KG_ACCESS_TOKEN_EXPIRE_MINUTES=60
KG_RATE_LIMIT_PER_MINUTE=100
KG_RATE_LIMIT_BURST=200
KG_CORS_ORIGINS=["*"]
KG_OPENAI_API_KEY=
KG_DEBUG=false

# Frontend (Next.js — no prefix)
NEXT_PUBLIC_API_URL=http://localhost:8000
